# Copy this file to .env.local for local development and fill in the values
# from your Supabase project settings (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: protect the whole dashboard with a single shared password
# (simple Basic Auth). Leave both blank to keep the app open to anyone
# with the URL. Set both to enable the login prompt.
DASHBOARD_USER=founder
DASHBOARD_PASSWORD=

# Which email transport the "Email küldése" buttons (Suppliers, Orders,
# Documents, Marketing, Megosztások) actually send through — "gmail"
# (default, sends as zusammen.swiss@gmail.com via OAuth, see below) or
# "resend" (see the two blocks below). See the README for how/when to
# switch — every button goes through this one setting, nothing is
# provider-specific in the page code.
# EMAIL_PROVIDER=gmail

# --- Gmail (default) --------------------------------------------------
# Required for EMAIL_PROVIDER=gmail (or unset, since it's the default).
# Create these in Google Cloud Console — see the README for step-by-step
# instructions. Never expose these as NEXT_PUBLIC_ variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A 32-byte (64 hex character) key used to encrypt the Gmail refresh
# token before it's stored in Supabase — generate one with
# `openssl rand -hex 32`. Required for EMAIL_PROVIDER=gmail.
TOKEN_ENCRYPTION_KEY=

# The Supabase "service_role" key (Project Settings → API → service_role,
# NOT the anon key above) — required for EMAIL_PROVIDER=gmail so the
# server can read/write the gmail_connection table, which deliberately
# has no anon RLS policy. A real secret: never expose this as a
# NEXT_PUBLIC_ variable, never commit it, never reuse the anon key here.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (fallback) --------------------------------------------------
# Required only if you set EMAIL_PROVIDER=resend. Get a key from
# resend.com — see the README for step-by-step instructions. Never
# expose this as a NEXT_PUBLIC_ variable.
# RESEND_API_KEY=

# Optional overrides — safe to leave unset while testing, see the README
# for when/why to change them.
# RESEND_FROM_EMAIL="Zusammen <onboarding@resend.dev>"
# RESEND_REPLY_TO=zusammen.swiss@gmail.com

# Optional: enables the daily "what's due" reminder email (vercel.json
# cron -> /api/reminder-email). Leave unset to keep that route disabled.
# Any long random string works — e.g. `openssl rand -hex 32`. See the
# README for how Vercel uses this automatically.
# CRON_SECRET=
# REMINDER_EMAIL_TO=zusammen.swiss@gmail.com

# Optional: the real production URL, once there is one — used to build
# absolute Open Graph / Twitter Card preview URLs for /landing (see
# app/landing/layout.tsx and app/api/og/route.tsx). Leave unset while
# testing; falls back to the default Vercel preview domain
# (https://zusammen-dashboard.vercel.app), which won't match your actual
# deployment URL, so social previews will point at the wrong place until
# this is set.
# SITE_URL=https://zusammen.swiss

# Optional: the password for the "founder view" (aggregate survey stats)
# on the public /landing page. Leave unset to keep the original default
# ("zusammen2026") — set this before sharing the /landing link so the
# real password isn't sitting in git history. Note this ships in the
# public JS bundle (it's a NEXT_PUBLIC_ variable, required since the
# check runs in the browser) — it's a soft gate against casual clicks,
# not real security; don't reuse a password you use elsewhere.
# NEXT_PUBLIC_LANDING_FOUNDER_PASSWORD=
