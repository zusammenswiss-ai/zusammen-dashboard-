# Copy this file to .env.local for local development and fill in the values
# from your Supabase project settings (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: protect the whole dashboard with a single shared password
# (simple Basic Auth). Leave both blank to keep the app open to anyone
# with the URL. Set both to enable the login prompt.
DASHBOARD_USER=founder
DASHBOARD_PASSWORD=
